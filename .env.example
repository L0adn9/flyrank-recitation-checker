# Copy to .env and change the values. Never commit .env.

# Postgres (used by docker compose and by the app)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/recite

# Auth: long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

# Speech recognition (whisper.cpp + two open Quran models, see scripts/get_model.sh)
WHISPER_CLI=whisper-cli
WHISPER_MODEL=models/ggml-tarbiyah-small-q8_0.bin
WHISPER_FAST_MODEL=models/ggml-tarteel-base-q8_0.bin
# CPU threads per recognition; about half your cores works well
WHISPER_THREADS=8
# whisper-server binary: keeps the models loaded for live checking (Docker sets it)
WHISPER_SERVER=

# Where uploads and generated PDFs are stored
STORAGE_DIR=storage

# Daily revision plan (cron syntax, in TZ below)
REVISION_CRON=0 5 * * *
TZ=UTC

# Demo account created by the seed (local test value only)
DEMO_EMAIL=demo@recite.test
DEMO_PASSWORD=demo-recite-2026
